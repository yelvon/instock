# 复制为 .env 后按需修改（docker compose 会自动读取同目录下的 .env）
# cp .env.example .env

# ---------- MariaDB（数据落在宿主机目录，对应容器内 /var/lib/mysql）----------
# 必须为本机绝对路径；不要用 ~，Compose 展开不一定可靠
INSTOCK_MARIADB_DATA=/Users/你的用户名/instock-docker/mariadb/data

MYSQL_ROOT_PASSWORD=root

# 若本机 3306 已被占用，可改为 3307:3306 映射，DataGrip 连对应宿主机端口
MARIADB_HOST_PORT=3306

# ---------- InStock 应用 ----------
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=instockdb
DB_PORT=3306

# Tushare token；复制为 docker/.env 后填写，docker-compose.yml 会透传给容器
TUSHARE_TOKEN=

# 代理 / Cookie（宿主机上的文件路径，须先 touch 创建空文件）
INSTOCK_PROXY_FILE=/Users/你的用户名/instock-docker/instockproxy.txt
INSTOCK_COOKIE_FILE=/Users/你的用户名/instock-docker/eastmoneycookie.txt

# （可选）挂载本机仓库代码供开发；不需要则留空或删除下行，并在 compose 里去掉对应挂载
# INSTOCK_REPO_ROOT=/Users/你的用户名/stock/instock

# ---------- 通达信本地日线（Parallels / Mac 路径 → 容器 /tdx）----------
# 必须为通达信安装根目录（其下含 vipdoc/sh/lday、vipdoc/sz/lday），不要用 vipdoc 本身
# 路径含空格时建议用符号链接，例如：ln -sfn "/Volumes/[C] Windows 11/new_tdx" ~/tdx-docker-mount
INSTOCK_TDX_DIR_HOST=/Users/你的用户名/tdx-docker-mount
# INSTOCK_UNIVERSE_SOURCE=local
# INSTOCK_BAR_DATA_SOURCE=mootdx
# 标准库补数：区间内 raw 已完整则跳过该股（默认 1）；设为 0 则全量重 merge
# INSTOCK_SYNC_SKIP_COMPLETE=1
# SMB 挂载通达信时建议单 worker，避免 Errno 5
# INSTOCK_MOOTDX_LOCAL_WORKERS=1
# push2 不通时跳过东财资金流等作业
# INSTOCK_SKIP_EM_PUSH2=1
