# 复制为 .env 后按需修改（docker compose 会自动读取同目录下的 .env）
# cp .env.example .env

# ---------- MariaDB（数据落在宿主机目录，对应容器内 /var/lib/mysql）----------
# 必须为本机绝对路径；不要用 ~，Compose 展开不一定可靠
INSTOCK_MARIADB_DATA=/Users/你的用户名/instock-docker/mariadb/data

MYSQL_ROOT_PASSWORD=root

# 若本机 3306 已被占用，可改为 3307:3306 映射，DataGrip 连对应宿主机端口
MARIADB_HOST_PORT=3306

# ---------- InStock 应用 ----------
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=instockdb
DB_PORT=3306

# 代理 / Cookie（宿主机上的文件路径，须先 touch 创建空文件）
INSTOCK_PROXY_FILE=/Users/你的用户名/instock-docker/instockproxy.txt
INSTOCK_COOKIE_FILE=/Users/你的用户名/instock-docker/eastmoneycookie.txt

# （可选）挂载本机仓库代码供开发；不需要则留空或删除下行，并在 compose 里去掉对应挂载
# INSTOCK_REPO_ROOT=/Users/你的用户名/stock/instock
