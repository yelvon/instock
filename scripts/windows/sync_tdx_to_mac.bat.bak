@echo off
REM SYNC_BAT_VERSION=3 vipdoc + gbbq to Mac tdx-local via Z drive
setlocal EnableDelayedExpansion
echo [sync_tdx_to_mac.bat] version=3

set "TDX_SRC=C:\new_tdx"
if exist "Z:\" (
    set "MAC_VIPDOC=Z:\tdx-local\vipdoc"
    set "MAC_HOME=Z:\"
) else (
    set "MAC_VIPDOC=\\Mac\Home\tdx-local\vipdoc"
    set "MAC_HOME=\\Mac\Home\"
)
set "LOG=%USERPROFILE%\sync_tdx_to_mac.log"

if not exist "%TDX_SRC%\vipdoc\sh\lday" (
    echo [ERROR] Missing %TDX_SRC%\vipdoc - run TDX post-market download first
    exit /b 1
)
if not exist "%MAC_HOME%" (
    echo [ERROR] Mac share not found - enable Parallels Shared Folders
    exit /b 1
)

mkdir "%MAC_HOME%tdx-local" 2>nul
mkdir "%MAC_VIPDOC%" 2>nul

echo [%date% %time%] sync start >> "%LOG%"
echo SRC: %TDX_SRC%\vipdoc
echo DST: %MAC_VIPDOC%

robocopy "%TDX_SRC%\vipdoc" "%MAC_VIPDOC%" /E /XO /R:2 /W:3 /NP /LOG+:"%LOG%" /TEE

set RC=%ERRORLEVEL%
echo robocopy vipdoc exit: %RC%
if %RC% GEQ 8 exit /b %RC%

set "MAC_HQ=%MAC_HOME%tdx-local\T0002\hq_cache"
set "WIN_HQ=%TDX_SRC%\T0002\hq_cache"
set "GBBQ_OK=0"
if exist "%WIN_HQ%" (
    mkdir "%MAC_HQ%" 2>nul
    for %%F in (gbbq gbbq.dat gbbq.map) do (
        if exist "%WIN_HQ%\%%F" (
            robocopy "%WIN_HQ%" "%MAC_HQ%" %%F /XO /R:2 /W:3 /NP /LOG+:"%LOG%" /TEE
            echo copied %%F exit: !ERRORLEVEL!
            set "GBBQ_OK=1"
        )
    )
)
if "!GBBQ_OK!"=="0" (
    echo [WARN] no gbbq in %WIN_HQ%
    echo [WARN] run TDX online then download hq_cache gbbq before sync
)

exit /b 0
