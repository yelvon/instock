# InStock 数据库（与 instock/lib/database.py 一致）
# db_host=localhost
# db_user=root
# db_password=root
# db_database=instockdb
# db_port=3306

# 数据管线（可选）
# 每日总任务中是否同步交易日历到表 trade_calendar（默认 1）
# INSTOCK_SYNC_TRADE_CALENDAR=1

# 校验失败时是否中断（basic_data_daily_job 扩展参数模式或 ETF 写入后 len(sys.argv)==1）
# INSTOCK_QUALITY_STRICT=0

# 关闭写库后自动质量校验日志
# INSTOCK_QUALITY_DISABLED=0

# 跳过 H6（非交易日也跑校验时使用）
# INSTOCK_SKIP_H6=0

# 主表最少行数阈值（可按本地全市场股票数量调整）
# QUALITY_STOCK_MIN_ROWS=3500
# QUALITY_ETF_MIN_ROWS=400
