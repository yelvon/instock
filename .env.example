# InStock 数据库（与 instock/lib/database.py 一致）
# db_host=localhost
# db_user=root
# db_password=root
# db_database=instockdb
# db_port=3306

# 数据管线（可选）
# 每日总任务中是否同步交易日历到表 trade_calendar（默认 1）
# INSTOCK_SYNC_TRADE_CALENDAR=1

# 校验失败时是否中断（basic_data_daily_job 扩展参数模式或 ETF 写入后 len(sys.argv)==1）
# INSTOCK_QUALITY_STRICT=0

# 关闭写库后自动质量校验日志
# INSTOCK_QUALITY_DISABLED=0

# 跳过 H6（非交易日也跑校验时使用）
# INSTOCK_SKIP_H6=0

# 主表最少行数阈值（可按本地全市场股票数量调整）
# QUALITY_STOCK_MIN_ROWS=3500
# QUALITY_ETF_MIN_ROWS=400

# 回测数据治理（registry / 血缘）
# INSTOCK_DATA_PROFILE=live
# INSTOCK_BAR_MODE=raw
# INSTOCK_TDX_DIR=/path/to/tdx
# INSTOCK_USE_DATA_REGISTRY=0
# INSTOCK_TENCENT_ENRICH=1
# 股票快照默认 auto：东财失败时回退 Baostock；可设 eastmoney 强制只用东财
# INSTOCK_SPOT_DATA_SOURCE=auto
# 东财 requests 默认不继承系统代理；确需使用系统代理时设为 1
# INSTOCK_HTTP_TRUST_ENV=0
# 东财 Cookie 默认不发送；只有确认 Cookie 新鲜且接口需要时再启用
# INSTOCK_EM_USE_COOKIE=0
# Tushare token 可用环境变量覆盖；也可写入 instock/config/tushare_token.txt（不提交）
# TUSHARE_TOKEN=
